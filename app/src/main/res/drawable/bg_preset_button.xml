<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_direction_pressed" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/mcqueen_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_preset_bg" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/mcqueen_red" />
        </shape>
    </item>
</selector>